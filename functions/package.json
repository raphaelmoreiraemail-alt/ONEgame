{
  "name": "onegame-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:rng-vectors": "tsx scripts/genRngVectors.ts",
    "copy-shared": "node scripts/copyShared.mjs",
    "prebuild": "node scripts/copyShared.mjs",
    "prelint": "node scripts/copyShared.mjs",
    "pretest": "node scripts/copyShared.mjs",
    "test:emulators": "firebase emulators:exec --only firestore --project demo-onegame \"vitest run --config vitest.emulator.config.ts\"",
    "pretest:emulators": "node scripts/copyShared.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.6",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module"
}
